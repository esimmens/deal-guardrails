    {
      "parameters": {
        "jsCode": "// POST /notifications/dispatch takes an empty JSON object; sign \"<ts>.{}\" with the shared secret.\nconst crypto = require('crypto');\n\nlet secret;\ntry {\n  secret = $env.DG_N8N_SHARED_SECRET;\n} catch (e) {\n  throw new Error('n8n blocks $env in this build. Set N8N_BLOCK_ENV_ACCESS_IN_NODE=\"false\" on the n8n container. (' + e.message + ')');\n}\nif (!secret) {\n  throw new Error('DG_N8N_SHARED_SECRET is empty or not set on the n8n container.');\n}\n\nconst body = '{}';\nconst ts = String(Math.floor(Date.now() / 1000));\nconst sig = 'sha256=' + crypto.createHmac('sha256', secret).update(ts + '.' + body, 'utf8').digest('hex');\nreturn [{ json: { body: body, ts: ts, sig: sig } }];\n"
      },
      "id": "1cdc2213-d30b-5ef6-8c92-005d9464d9d2",
      "name": "Sign empty body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://service:8000/notifications/dispatch",
        "sendHeaders": true,
        "specifyHeaders": "keypair",
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-DG-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-DG-Signature",
              "value": "={{ $json.sig }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "autodetect"
            }
          },
          "timeout": 30000
        }
      },
      "id": "c87c149a-07c8-5a1e-84e8-aaf51cc9ef01",
      "name": "POST notifications dispatch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        480,
