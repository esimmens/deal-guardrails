# Copy to .env and fill in. Never commit .env.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-reserved-name.ngrok-free.dev
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
# The intake Slack app ("Oriel Deal Desk"), the bring-your-own app the ElevenAgents DM trigger runs on.
# n8n posts the decision from it so the answer lands in the conversation the AE asked in.
SLACK_INTAKE_BOT_TOKEN=xoxb-
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
PG_ADMIN_PASSWORD=dg_admin_dev_pw
PG_SERVICE_PASSWORD=dg_service_dev_pw
PG_READER_PASSWORD=dg_reader_dev_pw
DG_TOOL_TOKEN=            # openssl rand -hex 32 ; the ElevenAgents tool sends this as a bearer
DG_N8N_SHARED_SECRET=     # openssl rand -hex 32 ; HMAC key between n8n and the service
N8N_ENCRYPTION_KEY=       # openssl rand -hex 32
